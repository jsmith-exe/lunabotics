<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="false"/>
      </Interfaces>
    </General>
    <Internal>
      <SocketReceiveBufferSize max="10MB"/>
    </Internal>
    <Discovery>
      <Peers>
        <Peer address="192.168.1.167"/> <!-- Basestation -->
        <Peer address="192.168.1.29"/> <!-- Jetson -->
        <Peer address="127.0.0.1"/> <!-- Localhost -->
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>100</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
