<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- Materials -->
  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.2 1.0 1.0"/></material>

  <!-- ========================================================= -->
  <!-- Main dimensions                                           -->
  <!-- ========================================================= -->

  <!-- Bottom welded frame (kept TEMPORARILY to not break drum, needs REMOVED) -->
  <xacro:property name="base_x" value="0.925"/>
  <xacro:property name="base_y" value="0.745"/>
  <xacro:property name="base_z" value="0.025"/>

  <!-- Square tubing cross-section: 1 inch x 1 inch -->
  <xacro:property name="bar_t" value="0.0254"/>

  <!-- Base frame bar lengths -->
  <xacro:property name="base_long_len" value="1.17460"/>
  <xacro:property name="base_short_len" value="0.74360"/>

  <!-- Top frame bar lengths -->
  <xacro:property name="top_long_len" value="0.8396"/>
  <xacro:property name="top_short_len" value="0.74360"/>

  <!-- Support bar lengths -->
  <xacro:property name="upper_support_len" value="0.2246"/>
  <xacro:property name="lower_support_len" value="0.1746"/>
  <xacro:property name="wheel_support_len" value="0.9"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_r" value="0.15"/>
  <xacro:property name="wheel_w" value="0.15"/>

  <!-- ========================================================= -->
  <!-- Derived values                                            -->
  <!-- ========================================================= -->

  <!-- Base lift -->
  <xacro:property name="base_link_z" value="${wheel_r / 2 + lower_support_len + bar_t}"/>

  <!-- Top frame position -->
  <xacro:property name="top_frame_z" value="${upper_support_len + bar_t}"/>

  <!-- ========================================================= -->
  <!-- Base frames                                               -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Bar macro                                                 -->
  <!-- ========================================================= -->

  <xacro:macro name="box_member" params="name sx sy sz mass colour">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
        <material name="${colour}"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${sx} ${sy} ${sz}"/>
        </geometry>
      </collision>

      <xacro:inertial_box mass="${mass}" x="${sx}" y="${sy}" z="${sz}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <gazebo reference="${name}">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <!-- ========================================================= -->
  <!-- Bottom welded frame                                       -->
  <!-- ========================================================= -->

  <xacro:box_member
    name="front_base_bar"
    sx="${bar_t}"
    sy="${base_short_len}"
    sz="${bar_t}"
    mass="1.0"
    colour="black"/>

  <xacro:box_member
    name="front_inner_base_bar"
    sx="${bar_t}"
    sy="${base_short_len}"
    sz="${bar_t}"
    mass="1.0"
    colour="black"/>

  <xacro:box_member
      name="rear_base_bar"
      sx="${bar_t}"
      sy="${base_short_len}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
    name="rear_inner_base_bar"
    sx="${bar_t}"
    sy="${base_short_len}"
    sz="${bar_t}"
    mass="1.0"
    colour="black"/>

  <xacro:box_member
      name="left_base_bar"
      sx="${base_long_len}"
      sy="${bar_t}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="right_base_bar"
      sx="${base_long_len}"
      sy="${bar_t}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <joint name="front_base_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_base_bar"/>
    <origin xyz="${base_long_len / 2 + bar_t / 2} 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="front_inner_base_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_inner_base_bar"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="rear_base_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_base_bar"/>
    <origin xyz="${-base_long_len / 2 - bar_t / 2} 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="rear_inner_base_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_inner_base_bar"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="left_base_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_base_bar"/>
    <origin xyz="0 ${base_short_len / 2 - bar_t / 2} 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_base_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_base_bar"/>
    <origin xyz="0 ${-base_short_len / 2 + bar_t / 2} 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Top welded frame                                          -->
  <!-- ========================================================= -->

  <xacro:box_member
    name="front_top_bar"
    sx="${bar_t}"
    sy="${top_short_len}"
    sz="${bar_t}"
    mass="1.0"
    colour="black"/>

  <xacro:box_member
      name="rear_top_bar"
      sx="${bar_t}"
      sy="${top_short_len}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="left_top_bar"
      sx="${top_long_len}"
      sy="${bar_t}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="right_top_bar"
      sx="${top_long_len}"
      sy="${bar_t}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <joint name="front_top_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_top_bar"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} 0 ${top_frame_z}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_top_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_top_bar"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} 0 ${top_frame_z}" rpy="0 0 0"/>
  </joint>

  <joint name="left_top_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_top_bar"/>
    <origin xyz="0 ${top_short_len / 2 - bar_t / 2} ${top_frame_z}" rpy="0 0 0"/>
  </joint>

  <joint name="right_top_bar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_top_bar"/>
    <origin xyz="0 ${-top_short_len / 2 + bar_t / 2} ${top_frame_z}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Upper supports                                            -->
  <!-- ========================================================= -->

  <xacro:box_member
      name="front_left_upper_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${upper_support_len}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="front_right_upper_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${upper_support_len}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="rear_left_upper_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${upper_support_len}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="rear_right_upper_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${upper_support_len}"
      mass="1.0"
      colour="black"/>

  <joint name="front_left_upper_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_upper_support"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} ${base_short_len / 2 - bar_t / 2} ${upper_support_len / 2 + bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="front_right_upper_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_upper_support"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} ${-base_short_len / 2 + bar_t / 2} ${upper_support_len / 2 + bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_left_upper_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_upper_support"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} ${base_short_len / 2 - bar_t / 2} ${upper_support_len / 2 + bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_right_upper_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_upper_support"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} ${-base_short_len / 2 + bar_t / 2} ${upper_support_len / 2 + bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Lower supports                                            -->
  <!-- ========================================================= -->

  <xacro:box_member
      name="front_left_lower_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${lower_support_len}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="front_right_lower_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${lower_support_len}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="rear_left_lower_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${lower_support_len}"
      mass="1.0"
      colour="black"/>

  <xacro:box_member
      name="rear_right_lower_support"
      sx="${bar_t}"
      sy="${bar_t}"
      sz="${lower_support_len}"
      mass="1.0"
      colour="black"/>

  <joint name="front_left_lower_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_lower_support"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} -0.1396 ${-lower_support_len / 2 - bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="front_right_lower_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_lower_support"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} 0.1396 ${-lower_support_len / 2 - bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_left_lower_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_lower_support"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} -0.1396 ${-lower_support_len / 2 - bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_right_lower_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_lower_support"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} 0.1396 ${-lower_support_len / 2 - bar_t / 2}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Wheel supports                                            -->
  <!-- ========================================================= -->

  <xacro:box_member
    name="front_wheel_support"
    sx="${bar_t}"
    sy="${wheel_support_len}"
    sz="${bar_t}"
    mass="1.0"
    colour="black"/>

  <xacro:box_member
      name="rear_wheel_support"
      sx="${bar_t}"
      sy="${wheel_support_len}"
      sz="${bar_t}"
      mass="1.0"
      colour="black"/>

  <joint name="front_wheel_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_wheel_support"/>
    <origin xyz="${top_long_len / 2 + bar_t / 2} 0 ${-lower_support_len - bar_t}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_wheel_support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_wheel_support"/>
    <origin xyz="${-top_long_len / 2 - bar_t / 2} 0 ${-lower_support_len - bar_t}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================================= -->
  <!-- Wheel macro                                               -->
  <!-- ========================================================= -->

  <!-- Sim tyre profile: same overall size as the plain collision cylinder below. -->
  <xacro:property name="tyre_r" value="${wheel_r * 0.98}"/>
  <xacro:property name="tyre_half_w" value="${wheel_w * 0.95 / 2}"/>
  <xacro:property name="tyre_fillet" value="0.04"/>
  <xacro:property name="tyre_slice_w" value="${tyre_fillet / 3}"/>

  <!-- One pair of edge slices, `index` 1..3 from the core outwards. Each slice takes the
       arc's radius at its own mid-width. -->
  <xacro:macro name="tyre_edge_slice" params="index">
    <xacro:property name="d" value="${(index - 0.5) * tyre_slice_w}"/>
    <xacro:property name="slice_r" value="${tyre_r - tyre_fillet + (tyre_fillet ** 2 - d ** 2) ** 0.5}"/>
    <xacro:property name="slice_y" value="${tyre_half_w - tyre_fillet + d}"/>
    <collision>
      <origin xyz="0 ${slice_y} 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${slice_r}" length="${tyre_slice_w}"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 ${-slice_y} 0" rpy="${pi / 2} 0 0"/>
      <geometry>
        <cylinder radius="${slice_r}" length="${tyre_slice_w}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <!-- Sim: rounded tyre edges, so the rim doesn't dig into the terrain mesh when
           skid-steering. ODE has no filleted shape and mesh-on-mesh contact is poor,
           so the profile is a full-radius core plus three thinner cylinders per side
           stepping down a tyre_fillet-radius arc. The real URDF keeps the plain cylinder. -->
      <xacro:if value="$(arg sim_mode)">
        <collision>
          <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
          <geometry>
            <cylinder radius="${tyre_r}" length="${2 * (tyre_half_w - tyre_fillet)}"/>
          </geometry>
        </collision>
        <xacro:tyre_edge_slice index="1"/>
        <xacro:tyre_edge_slice index="2"/>
        <xacro:tyre_edge_slice index="3"/>
      </xacro:if>
      <xacro:unless value="$(arg sim_mode)">
        <collision>
          <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_r * 0.98}" length="${wheel_w * 0.95}"/>
          </geometry>
        </collision>
      </xacro:unless>

      <xacro:inertial_cylinder mass="0.5" length="${wheel_w}" radius="${wheel_r}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <gazebo reference="${name}">
      <material>Gazebo/Red</material>
    </gazebo>

    <gazebo reference="${name}">
      <fdir1>1 0 0</fdir1>
      <mu1>1.4</mu1>
      <mu2>0.2</mu2>
      <slip1>0.0</slip1>
      <slip2>0.0</slip2>
    </gazebo>
  </xacro:macro>

  <!-- ========================================================= -->
  <!-- Wheels                                                    -->
  <!-- ========================================================= -->

  <xacro:wheel_link name="front_left_wheel"/>
  <xacro:wheel_link name="front_right_wheel"/>
  <xacro:wheel_link name="rear_left_wheel"/>
  <xacro:wheel_link name="rear_right_wheel"/>

  <!-- Wheel joints. On the real rover (and with sim_mode false) each wheel is
       attached straight to base_link. In simulation it hangs from a short
       vertical spring ("sand joint") instead: the rover has no suspension,
       but its wheels sink into sand, which keeps all four loaded on uneven
       ground. With rigid wheels on rigid ground Gazebo rocks the chassis onto
       two diagonal wheels and skid-steer turning roughly halves. Joint names
       seen by ros2_control are unchanged. -->

  <!-- Sand compliance, sim only. Spring is preloaded (sand_ref) so the rover
       rests at its normal ride height with ~1.5 cm of give either way. -->
  <xacro:property name="sand_k" value="4000.0"/>          <!-- N/m per wheel -->
  <xacro:property name="sand_damping" value="250.0"/>     <!-- N.s/m, ~critical -->
  <xacro:property name="sand_travel" value="0.03"/>       <!-- m, hard stop either way -->
  <!-- weight carried by each spring: the 25.3 kg rover minus its four 0.5 kg
       wheels (the sprung links below add 4 kg on top, sim only) -->
  <xacro:property name="wheel_load" value="${(25.3 - 4 * 0.5) * 9.81 / 4}"/>  <!-- N -->
  <xacro:property name="sand_ref" value="${-wheel_load / sand_k}"/>

  <xacro:macro name="wheel_mount" params="name xyz">
    <xacro:if value="$(arg sim_mode)">
      <!-- 1 kg, not a token mass: ODE's iterative solver can't hold a
           25 kg chassis on a near-massless link and the joints blow
           through their stops. Adds 4 kg to the sim rover. -->
      <link name="${name}_sand_link">
        <inertial>
          <mass value="1.0"/>
          <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
        </inertial>
      </link>

      <joint name="${name}_sand_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="${name}_sand_link"/>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-sand_travel}" upper="${sand_travel}" effort="10000" velocity="10"/>
        <dynamics damping="${sand_damping}"/>
      </joint>

      <!-- implicit: the stiff spring/damper on a light link is unstable
           with ODE's default explicit integration and the sim blows up -->
      <gazebo reference="${name}_sand_joint">
        <springStiffness>${sand_k}</springStiffness>
        <springReference>${sand_ref}</springReference>
        <implicitSpringDamper>true</implicitSpringDamper>
      </gazebo>

      <joint name="${name}_joint" type="continuous">
        <parent link="${name}_sand_link"/>
        <child link="${name}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
      </joint>
    </xacro:if>

    <xacro:unless value="$(arg sim_mode)">
      <joint name="${name}_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}"/>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
      </joint>
    </xacro:unless>
  </xacro:macro>

  <xacro:wheel_mount name="front_left_wheel"
      xyz="${top_long_len / 2 + bar_t / 2} ${wheel_support_len / 2} ${-lower_support_len - bar_t}"/>
  <xacro:wheel_mount name="front_right_wheel"
      xyz="${top_long_len / 2 + bar_t / 2} ${-wheel_support_len / 2} ${-lower_support_len - bar_t}"/>
  <xacro:wheel_mount name="rear_left_wheel"
      xyz="${-top_long_len / 2 - bar_t / 2} ${wheel_support_len / 2} ${-lower_support_len - bar_t}"/>
  <xacro:wheel_mount name="rear_right_wheel"
      xyz="${-top_long_len / 2 - bar_t / 2} ${-wheel_support_len / 2} ${-lower_support_len - bar_t}"/>

  <!-- The sand joints aren't ros2_control joints, so publish their state for TF. -->
  <xacro:if value="$(arg sim_mode)">
    <gazebo>
      <plugin name="sand_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
        <update_rate>50</update_rate>
        <joint_name>front_left_wheel_sand_joint</joint_name>
        <joint_name>front_right_wheel_sand_joint</joint_name>
        <joint_name>rear_left_wheel_sand_joint</joint_name>
        <joint_name>rear_right_wheel_sand_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
