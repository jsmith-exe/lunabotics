<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunabotics_us_arena_terrain">

    <!-- PHYSICS (Gazebo Harmonic). 1 ms steps: the terramechanics plugin updates the
         wheel-soil forces every step and needs fresh contact data to stay stable. -->
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <!-- wheel contact sensors, read by the terramechanics plugin -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <pose>0 0 10 0 0 0</pose>
      <!-- lower sun than us_arena.world so the undulations shade visibly -->
      <direction>-0.6 0.3 -0.6</direction>
    </light>

    <!-- PHYSICAL ARENA -->
    <!-- Terrain -->
    <!-- Sand floor: one mesh (visual = collision) from generate_arena_terrain.py.
         Flat (z = 0) along the walls, in the starting zone and in the
         construction zone; gentle hills (max 6 deg) everywhere else.
         The mesh is in arena coordinates, so it goes in at the origin.
         The sand itself is the terramechanics plugin on the rover
         (config/terramechanics): it matches this model by name, arena_terrain.
         sim.launch.py normally swaps this include for a freshly generated
         floor with random craters, plus random boulders (arena_obstacles.py);
         launch with obstacles:=false to get this plain floor. -->
    <include>
      <uri>model://arena_terrain</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Walls -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9.14 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.14 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>4.57 -0.05 0.25 0 0 0</pose>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9.14 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.14 0.1 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>4.57 8.15 0.25 0 0 0</pose>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.10 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.10 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>-0.05 4.05 0.25 0 0 0</pose>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.10 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.10 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>9.19 4.05 0.25 0 0 0</pose>
      </link>
    </model>

    <!-- Zone markers from us_arena.world are left out: the flat boxes would
         cut through the hills and give the VO fake features. Zones are drawn
         in RViz instead. -->

    <!-- Fiducial Rail -->
    <model name="fiducial_rail_marker">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.01 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 1 0.3</ambient>
            <diffuse>0 1 1 0.3</diffuse>
          </material>
        </visual>
        <pose>3.32 0.005 0.425 0 0 0</pose>
      </link>
    </model>

    <!-- APRILTAG -->
    <model name="apriltag_0">
      <static>true</static>
      <pose>3.32 0.02 0.4 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.01 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.01 0.4 0.4</size></box></geometry>
          <!-- Harmonic (ogre2) can't read OGRE material scripts, so the tag bitmap
               goes in as a PBR albedo map -->
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://apriltag_model/materials/textures/tag36_11_00000.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>