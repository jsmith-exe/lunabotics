<?xml version="1.0"?>
<sdf version="1.6">
  <model name="terrain_heightmap">
    <static>true</static>
    <link name="terrain_link">
      <pose>0 0 0 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://terrain_heightmap/heightmap.png</uri>
            <size>7.9 7.9 0</size>
          </heightmap>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <heightmap>
            <uri>model://terrain_heightmap/heightmap.png</uri>
            <size>7.9 7.9 0</size>

            <!-- Regolith grain, not heightmap.png. heightmap.png is a uniform
                 128-grey image: it makes the terrain flat (which is intended)
                 but as a DIFFUSE map it puts zero intensity gradient on the
                 ground, and RGB-D visual odometry cannot hold inliers on a
                 surface with no gradient. <size> is in metres, so 2.0 gives a
                 2 m tile - roughly the scale of BP-1 clumping and rover tracks.
                 The normal map is left on heightmap.png: uniform, i.e. neutral.
                 See worlds/regolith_texture_gen.py. -->
            <texture>
              <size>2.0</size>
              <diffuse>model://regolith_model/materials/textures/regolith.png</diffuse>
              <normal>model://terrain_heightmap/heightmap.png</normal>
            </texture>
          </heightmap>
        </geometry>

        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>

    </link>
  </model>
</sdf>