// Arena surface materials.
//
// 'scale' is Ogre's texture-coordinate scale, so smaller values mean more
// repeats. Box faces are UV mapped 0..1 regardless of real size:
//
//     repeats = 1 / scale        tile_size_m = face_length_m * scale
//
// Re-derive these if the ground or walls are resized.

// Ground slab, 12 x 12 m (arena_ucf.world). 1/6 -> 2 m tile.
material Regolith/Ground
{
  technique
  {
    pass
    {
      texture_unit
      {
        texture regolith.png
        scale 0.1667 0.1667
        filtering trilinear
      }
    }
  }
}

// Walls. Vertical scale 1.0 = one repeat over the height. Horizontal scale is
// per wall length, to keep a ~0.4 m tile on every face.

// North / south walls: 4.4 m long. 11 repeats -> 0.40 m tiles.
material Regolith/WallShort
{
  technique
  {
    pass
    {
      texture_unit
      {
        texture arena_wall.png
        scale 0.0909 1.0
        filtering trilinear
      }
    }
  }
}

// East / west walls: 7.9 m long. 20 repeats -> 0.40 m tiles.
material Regolith/WallLong
{
  technique
  {
    pass
    {
      texture_unit
      {
        texture arena_wall.png
        scale 0.05 1.0
        filtering trilinear
      }
    }
  }
}

// Alias: arena_ucf.world references Regolith/Wall for its 0.4 m walls.
material Regolith/Wall : Regolith/WallShort
{
}
