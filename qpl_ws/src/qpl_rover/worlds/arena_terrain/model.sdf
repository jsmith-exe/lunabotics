<?xml version="1.0"?>
<!-- US arena sand floor, generated by worlds/generate_arena_terrain.py.

     The visual and the collision are the SAME mesh at the SAME pose, so the
     floor the cameras see is exactly the floor the wheels drive on. The mesh
     vertices are already in arena coordinates (origin at the south-west
     corner, flat floor at z = 0), so include this model at pose 0 0 0. -->
<sdf version="1.6">
  <model name="arena_terrain">
    <static>true</static>
    <link name="terrain_link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://arena_terrain/meshes/terrain.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://arena_terrain/meshes/terrain.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
