<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lunabotics_uk_arena">

    <!-- PHYSICS -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- Ground truth for localisation testing: publishes /gazebo/model_states -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- PHYSICAL ARENA -->
    <!-- Terrain -->
    <include>
      <uri>model://terrain_heightmap</uri>
    </include>

    <!-- Walls -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>0 -3.95 0.1 0 0 0</pose>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>0 3.95 0.1 0 0 0</pose>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>-2.2 0 0.1 0 0 0</pose>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <pose>2.2 0 0.1 0 0 0</pose>
      </link>
    </model>

    <!--
    BOULDER OBSTACLES (temporarily removed for avoidance-vs-navigation isolation; uncomment to restore)
    <model name="boulder_1">
      <pose>0.4 1.2 0.2 0 0 0</pose>
