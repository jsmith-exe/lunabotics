<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lunabotics_uk_arena">

    <!-- PHYSICS -->
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
    </physics>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground truth for localisation testing: publishes /gazebo/model_states.
         Inert otherwise - it adds a topic and nothing else. arena_ucf.world on
         the localisation branch carries the same plugin for the same reason. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- PHYSICAL ARENA -->
    <!-- Terrain -->
    <include>
      <uri>model://terrain_heightmap</uri>
    </include>

    <!-- Walls.
         Textured rather than flat-shaded, for the same reason as the ground:
         a solid-colour surface gives RGB-D visual odometry no intensity
         gradient to track, and at rover camera height the walls are most of
         what the front camera sees. Regolith/Wall's texture scale was derived
         for the UCF arena's 0.4 m walls, so on these 0.2 m walls the grain
         comes out finer; trilinear filtering keeps it from aliasing. -->
    <!-- Walls -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://regolith_model/materials/scripts/regolith.material</uri>
              <uri>model://regolith_model/materials/textures/</uri>
              <name>Regolith/Wall</name>
            </script>
          </material>
        </visual>
        <pose>0 -3.95 0.1 0 0 0</pose>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4 0.1 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://regolith_model/materials/scripts/regolith.material</uri>
              <uri>model://regolith_model/materials/textures/</uri>
              <name>Regolith/Wall</name>
            </script>
          </material>
        </visual>
        <pose>0 3.95 0.1 0 0 0</pose>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://regolith_model/materials/scripts/regolith.material</uri>
              <uri>model://regolith_model/materials/textures/</uri>
              <name>Regolith/Wall</name>
            </script>
          </material>
        </visual>
        <pose>-2.2 0 0.1 0 0 0</pose>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.9 0.2</size></box></geometry>
          <material>
            <script>
              <uri>model://regolith_model/materials/scripts/regolith.material</uri>
              <uri>model://regolith_model/materials/textures/</uri>
              <name>Regolith/Wall</name>
            </script>
          </material>
        </visual>
        <pose>2.2 0 0.1 0 0 0</pose>
      </link>
    </model>

    <!-- BOULDER OBSTACLES removed.
         They sat in the drive path used for localisation testing - boulder_2 at
         (0.3, -2.95) is 1.5 m directly in front of the rover spawn - and an
         open-loop dead-reckoning run that rams a rock is not a repeatable
         measurement of odometry drift. The arena walls are kept: they are the
         boundary, not obstacles. -->

    <!-- APRILTAG -->
    <model name="apriltag_0">
      <static>true</static>
      <pose>-2.145 -3.65 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.01 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.01 0.4 0.4</size></box></geometry>
          <material>
            <script>
              <uri>model://apriltag_model/materials/scripts/apriltag.material</uri>
              <uri>model://apriltag_model/materials/textures/</uri>
              <name>AprilTag/tag0</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>