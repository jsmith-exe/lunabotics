# Restarts can0 automatically when its transmitter stalls. Install on the Jetson with:
#   sudo cp ~/lunabotics/on_jetson_boot/can0-watchdog.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now can0-watchdog.service
# Restarts are logged: journalctl -u can0-watchdog -f
[Unit]
Description=Restart can0 when its transmitter stalls
After=can0-setup.service
Requires=can0-setup.service

[Service]
ExecStart=/bin/bash /home/qpl/lunabotics/on_jetson_boot/can_watchdog.sh can0
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
